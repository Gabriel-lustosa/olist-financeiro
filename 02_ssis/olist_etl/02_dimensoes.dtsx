        <SQLTask:SqlTaskData
          SQLTask:Connection="{9034E3C7-16C5-4754-A381-0AD2305C2A00}"
          SQLTask:SqlStatementSource="-- A fato aponta (FK) para as dimensões: ela é esvaziada primeiro.&#xA;-- Ela mesma não é referenciada por ninguém, então aceita TRUNCATE.&#xA;TRUNCATE TABLE dbo.FatoVendas;&#xA;&#xA;-- Dimensões referenciadas por FK não aceitam TRUNCATE (nem vazias) -&gt; DELETE&#xA;DELETE FROM dbo.DimCliente;&#xA;DELETE FROM dbo.DimVendedor;&#xA;DELETE FROM dbo.DimProduto;&#xA;DELETE FROM dbo.DimData;&#xA;&#xA;-- DELETE não zera o IDENTITY: volta o contador para a SK recomeçar em 1.&#xA;-- Só em tabela que já teve linha (em tabela nunca usada, RESEED 0 faria a SK começar em 0).&#xA;IF (SELECT last_value FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.DimCliente')) IS NOT NULL&#xA;    DBCC CHECKIDENT ('dbo.DimCliente', RESEED, 0);&#xA;IF (SELECT last_value FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.DimVendedor')) IS NOT NULL&#xA;    DBCC CHECKIDENT ('dbo.DimVendedor', RESEED, 0);&#xA;IF (SELECT last_value FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.DimProduto')) IS NOT NULL&#xA;    DBCC CHECKIDENT ('dbo.DimProduto', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
