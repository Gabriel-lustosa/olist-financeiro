    <DTS:Executable
      DTS:refId="Package\Carregar DimData"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarefa Executar SQL"
      DTS:DTSID="{89BA48E6-C5BF-4908-8305-F104DA342687}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Carregar DimData"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9034E3C7-16C5-4754-A381-0AD2305C2A00}"
          SQLTask:SqlStatementSource="-- Calendário 2016-01-01 a 2018-12-31 (mesmo script do 01_sql/04).&#xA;-- Nomes de mês e dia da semana em português&#xA;SET LANGUAGE 'Brazilian';&#xA;&#xA;WITH calendario AS (&#xA;    SELECT CAST('2016-01-01' AS DATE) AS data_completa&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, data_completa)&#xA;    FROM calendario&#xA;    WHERE data_completa &lt; '2018-12-31'&#xA;)&#xA;INSERT INTO dbo.DimData (&#xA;    sk_data, data_completa, ano, trimestre, mes_numero, mes_nome,&#xA;    dia, dia_semana_num, dia_semana_nome, eh_fim_semana&#xA;)&#xA;SELECT&#xA;    CAST(CONVERT(VARCHAR(8), data_completa, 112) AS INT),   -- YYYYMMDD&#xA;    data_completa,&#xA;    YEAR(data_completa),&#xA;    DATEPART(QUARTER, data_completa),&#xA;    MONTH(data_completa),&#xA;    DATENAME(MONTH, data_completa),&#xA;    DAY(data_completa),&#xA;    DATEPART(WEEKDAY, data_completa),&#xA;    DATENAME(WEEKDAY, data_completa),&#xA;    CASE WHEN DATEPART(WEEKDAY, data_completa) IN (1, 7) THEN 1 ELSE 0 END&#xA;FROM calendario&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
