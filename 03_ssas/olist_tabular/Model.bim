          {
            "name": "dia_semana_num",
            "dataType": "int64",
            "sourceColumn": "dia_semana_num"
          },
          {
            "name": "dia_semana_nome",
            "dataType": "string",
            "sourceColumn": "dia_semana_nome"
          },
          {
            "name": "eh_fim_semana",
            "dataType": "boolean",
            "sourceColumn": "eh_fim_semana"
          },
          {
            "type": "calculated",
            "name": "AnoMes",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT( DimData[data_completa], \"YYYY-MM\" )",
            "sortByColumn": "AnoMes Numero"
          },
          {
            "type": "calculated",
            "name": "AnoMes Numero",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "YEAR( DimData[data_completa] ) * 100 + MONTH( DimData[data_completa] )"
          },
          {
            "type": "calculated",
            "name": "Mes Indice",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "YEAR( DimData[data_completa] ) * 12 + MONTH( DimData[data_completa] )"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost;olist_financeiro\",",
                "    dbo_DimData = Source{[Schema=\"dbo\",Item=\"DimData\"]}[Data]",
                "in",
