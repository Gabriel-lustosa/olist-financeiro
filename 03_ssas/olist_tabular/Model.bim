    ],
    "tables": [
      {
        "name": "DimCliente",
        "columns": [
          {
            "name": "sk_cliente",
            "dataType": "int64",
            "sourceColumn": "sk_cliente"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id"
          },
          {
            "name": "customer_unique_id",
            "dataType": "string",
            "sourceColumn": "customer_unique_id"
          },
          {
            "name": "customer_zip_code_prefix",
            "dataType": "string",
            "sourceColumn": "customer_zip_code_prefix"
          },
          {
            "name": "customer_city",
            "dataType": "string",
            "sourceColumn": "customer_city"
          },
          {
            "name": "customer_state",
            "dataType": "string",
            "sourceColumn": "customer_state"
          },
          {
            "type": "calculated",
            "name": "Qtd Pedidos Entregues",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "CALCULATE( DISTINCTCOUNT( FatoVendas[order_id] ), ALLEXCEPT( DimCliente, DimCliente[customer_unique_id] ), FatoVendas[order_status] = \"delivered\" )"
          },
          {
            "type": "calculated",
            "name": "Tipo Cliente",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF( DimCliente[Qtd Pedidos Entregues] > 1, \"Recorrente\", \"Único\" )"
          },
          {
            "type": "calculated",
            "name": "AnoMes Aquisicao Numero",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "VAR DataPrimeiraCompra = CALCULATE( MINX( FatoVendas, RELATED( DimData[data_completa] ) ), ALLEXCEPT( DimCliente, DimCliente[customer_unique_id] ), FatoVendas[order_status] = \"delivered\" )",
              "RETURN IF( ISBLANK( DataPrimeiraCompra ), BLANK(), YEAR( DataPrimeiraCompra ) * 100 + MONTH( DataPrimeiraCompra ) )"
            ]
          },
          {
            "type": "calculated",
            "name": "AnoMes Aquisicao",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR N = DimCliente[AnoMes Aquisicao Numero]",
              "RETURN IF( ISBLANK( N ), BLANK(), FORMAT( DATE( INT( N / 100 ), MOD( N, 100 ), 1 ), \"YYYY-MM\" ) )"
            ],
            "sortByColumn": "AnoMes Aquisicao Numero"
          },
          {
            "type": "calculated",
            "name": "Aquisicao Mes Indice",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "VAR N = DimCliente[AnoMes Aquisicao Numero]",
              "RETURN IF( ISBLANK( N ), BLANK(), INT( N / 100 ) * 12 + MOD( N, 100 ) )"
            ]
          },
          {
            "type": "calculated",
            "name": "Regiao",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH( TRUE(),",
              "    DimCliente[customer_state] IN { \"SP\", \"RJ\", \"MG\", \"ES\" }, \"Sudeste\",",
              "    DimCliente[customer_state] IN { \"PR\", \"SC\", \"RS\" }, \"Sul\",",
              "    DimCliente[customer_state] IN { \"DF\", \"GO\", \"MT\", \"MS\" }, \"Centro-Oeste\",",
              "    DimCliente[customer_state] IN { \"AC\", \"AP\", \"AM\", \"PA\", \"RO\", \"RR\", \"TO\" }, \"Norte\",",
              "    DimCliente[customer_state] IN { \"AL\", \"BA\", \"CE\", \"MA\", \"PB\", \"PE\", \"PI\", \"RN\", \"SE\" }, \"Nordeste\",",
              "    \"?\" )"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost;olist_financeiro\",",
                "    dbo_DimCliente = Source{[Schema=\"dbo\",Item=\"DimCliente\"]}[Data]",
                "in",
                "    dbo_DimCliente"
              ]
            }
          }
        ]
      },
      {
        "name": "DimData",
        "columns": [
          {
