            "type": "calculatedTableColumn",
            "name": "Mes Relativo",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mes Relativo]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "SELECTCOLUMNS( GENERATESERIES( 0, 20, 1 ), \"Mes Relativo\", [Value] )"
            }
          }
        ]
