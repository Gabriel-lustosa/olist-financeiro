  "compatibilityLevel": 1700,
  "model": {
    "culture": "pt-BR",
    "dataSources": [
      {
        "type": "structured",
        "name": "SQL/localhost;olist_financeiro",
        "connectionDetails": {
          "protocol": "tds",
          "address": {
            "server": "localhost",
            "database": "olist_financeiro"
          },
          "authentication": null,
          "query": null
        },
